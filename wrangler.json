{
  "name": "nowview",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": {
      "enabled": true
    }
  },
  "triggers": {
    "crons": [
      "*/2 * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "NEWVIEW_SYNC_ROOMS",
        "class_name": "NewViewSyncRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "newview-sync-rooms-v1",
      "new_sqlite_classes": [
        "NewViewSyncRoom"
      ]
    }
  ]
}
